{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wtroiano/bounded-json",
    "description": "Bounded JSON canonicalization and schema validation",
    "homepage": "https://github.com/wtroiano86/bounded-json",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/wtroiano86/bounded-json/issues",
        "source": "https://github.com/wtroiano86/bounded-json",
        "docs": "https://github.com/wtroiano86/bounded-json#documentation"
    },
    "authors": [
        {
            "name": "William Troiano"
        }
    ],
    "keywords": [
        "json",
        "canonical json",
        "json schema",
        "validation",
        "laravel"
    ],
    "require": {
        "php": "^8.5.0",
        "ext-mbstring": "*",
        "illuminate/support": "^13.34"
    },
    "require-dev": {
        "pestphp/pest": "^5.2.1",
        "laravel/pint": "^1.32.1",
        "phpstan/phpstan": "^2.2.16",
        "pestphp/pest-plugin-type-coverage": "^5.0.2"
    },
    "autoload": {
        "psr-4": {
            "Wtroiano\\BoundedJson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wtroiano\\BoundedJson\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wtroiano\\BoundedJson\\Providers\\BoundedJsonServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test:metadata",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:coverage"
        ],
        "test:unit": "@php vendor/bin/pest",
        "test:metadata": "@composer validate --strict",
        "test:release": "@php .github/scripts/verify-release.php",
        "test:distribution": [
            "Composer\\Config::disableProcessTimeout",
            "sh .github/scripts/test-distribution.sh"
        ],
        "test:all": "@test",
        "test:lint": "@php vendor/bin/pint --test",
        "lint": "@php vendor/bin/pint",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:coverage": "@php vendor/bin/pest --coverage --exactly=100.0",
        "test:type-coverage": "@php vendor/bin/pest --type-coverage --min=100"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
